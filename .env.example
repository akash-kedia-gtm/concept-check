# Copy this file to .env.local and fill in real values.
# .env.local is excluded from git — never put secrets in .env.example.

# Your Supabase project URL (from Settings → API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Your publishable (anon) key (from Settings → API → Project API keys → anon public)
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Gemini AI API key — injected by AI Studio at runtime; not needed for local dev unless testing AI
GEMINI_API_KEY=your_gemini_api_key_here

# The URL where this app is hosted (used for CORS / OAuth callbacks)
APP_URL=http://localhost:3000
